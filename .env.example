# Copie para .env.<ENV> (ex.: .env.local) e preencha. ENV padrão: local.
# Variáveis já exportadas no processo têm precedência sobre o arquivo.

# APIs (obrigatórias, URL http(s))
ACCOUNT_API_URL=
TRANSFER_API_URL=

# Contas de teste pré-existentes (opcionais; sem elas os testes dependentes são pulados)
# Lista separada por vírgula; cada teste que muta saldo usa um índice fixo (ver tests/helpers/account/holds.ts)
ACTIVE_ACCOUNT_IDS=
BLOCKED_ACCOUNT_ID=
CLOSED_ACCOUNT_ID=
