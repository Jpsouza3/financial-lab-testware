{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "core",
    "domains",
    "interfaces",
    "services",
    "fixtures",
    "scripts",
    "tests",
    "playwright.config.ts"
  ]
}
